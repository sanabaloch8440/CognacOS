# CognacOS native NTDLL build, using sources in this directory.
CROSS ?= x86_64-w64-mingw32-
CC := $(CROSS)gcc
OBJDUMP := $(CROSS)objdump
OUTPUT ?= ntdll.dll
WINDOWS_NTDLL ?=
SYSCALL_HEADER ?= generated/ntdll_syscalls.h
WINDOWS_SYSCALL_IDS ?= 0
CFLAGS := -O2 -Wall -Wextra -Werror -ffreestanding -fno-stack-protector -fno-builtin -fno-asynchronous-unwind-tables -fno-unwind-tables
LDFLAGS := -shared -nostdlib -Wl,--subsystem,windows -Wl,--dynamicbase -Wl,--nxcompat -Wl,--high-entropy-va -Wl,--image-base,0x180000000 -Wl,--entry,DllMain -Wl,--no-insert-timestamp

ifeq ($(WINDOWS_SYSCALL_IDS),1)
CFLAGS += -DCOGNAC_USE_WINDOWS_SYSCALL_IDS
$(OUTPUT): $(SYSCALL_HEADER)
endif

.PHONY: all check clean helper-help syscall-header
all: $(OUTPUT)

$(OUTPUT): cognac_native.c cognac_rtl_string.c cognac_heap.c cognac_loader.c cognac_printf.c rtl_memory.c cognac_ntdll.def cognac_syscall_x86_64.S
	$(CC) $(CFLAGS) -DCOGNAC_NATIVE_NTDLL $(LDFLAGS) -o $@ cognac_native.c cognac_rtl_string.c cognac_heap.c cognac_loader.c cognac_printf.c rtl_memory.c cognac_syscall_x86_64.S cognac_ntdll.def

helper-help:
	python3 tools/ntdll_link_helper.py --help

# Extract service IDs from the exact Windows 11 x64 ntdll.dll at build time.
# Example: make -f Makefile.cognac syscall-header WINDOWS_NTDLL=/path/to/ntdll.dll
syscall-header:
	@test -n "$(WINDOWS_NTDLL)" || (echo "set WINDOWS_NTDLL=/path/to/x64/ntdll.dll" >&2; exit 2)
	python3 tools/ntdll_link_helper.py --input "$(WINDOWS_NTDLL)" --output "$(SYSCALL_HEADER)" --require NtClose --require NtYieldExecution --require NtQueryInformationProcess --require NtQueryInformationThread --require NtQuerySystemInformation

check: $(OUTPUT)
	$(OBJDUMP) -f $(OUTPUT) | grep -q 'pei-x86-64'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'DLL'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'AddressOfEntryPoint'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'NtClose'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'NtYieldExecution'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'NtQueryInformationProcess'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'NtQueryInformationThread'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'NtQuerySystemInformation'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlCompareMemory'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlCompareMemoryUlong'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlComputeCrc32'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlCrc32'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlIsZeroMemory'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlGetCurrentPeb'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlGetCurrentTeb'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlEnterCriticalSection'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlLeaveCriticalSection'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlAcquirePebLock'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlReleasePebLock'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'LdrGetProcedureAddress'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'LdrGetDllHandle'
	$(OBJDUMP) -p $(OUTPUT) | grep -q '_vsnprintf'
	$(OBJDUMP) -p $(OUTPUT) | grep -q '_vsnwprintf'
	$(OBJDUMP) -p $(OUTPUT) | grep -q '_vscprintf'
	$(OBJDUMP) -p $(OUTPUT) | grep -q '_vscwprintf'
	$(OBJDUMP) -p $(OUTPUT) | grep -q '_snprintf'
	$(OBJDUMP) -p $(OUTPUT) | grep -q '_snwprintf'
	$(OBJDUMP) -p $(OUTPUT) | grep -q '_vsnprintf_s'
	$(OBJDUMP) -p $(OUTPUT) | grep -q '_vsnwprintf_s'
	$(OBJDUMP) -p $(OUTPUT) | grep -q '_snprintf_s'
	$(OBJDUMP) -p $(OUTPUT) | grep -q '_snwprintf_s'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'vsprintf'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'vsprintf_s'
	$(OBJDUMP) -p $(OUTPUT) | grep -q '_vswprintf'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'vswprintf_s'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'sprintf'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'sprintf_s'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'swprintf'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'swprintf_s'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlGetLastWin32Error'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlSetLastWin32Error'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlGetLastNtStatus'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlSetLastWin32ErrorAndNtStatusFromNtStatus'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlGetVersion'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlGetNtVersionNumbers'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlNtStatusToDosError'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlNtStatusToDosErrorNoTeb'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlInitAnsiString'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlInitUnicodeString'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlCompareString'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlEqualString'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlCompareUnicodeString'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlEqualUnicodeString'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlCopyUnicodeString'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlUnicodeStringToInteger'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlIntegerToUnicodeString'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlGetProcessHeap'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlAllocateHeap'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlFreeHeap'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlReAllocateHeap'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlSizeHeap'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'RtlValidateHeap'
	$(OBJDUMP) -p $(OUTPUT) | grep -q 'CognacNtdllProcessHeapObject'
	! $(OBJDUMP) -p $(OUTPUT) | grep -q 'DLL Name:'

clean:
	rm -f $(OUTPUT)
