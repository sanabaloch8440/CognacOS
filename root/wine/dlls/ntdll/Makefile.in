# CognacOS native NTDLL module manifest.
# Wine's Unix companion/server path is intentionally disabled. The native
# PE32+ target is built and validated by Makefile.cognac and the CI workflow.
EXTRADEFS = -D_NTSYSTEM_ -D_ACRTIMP= -DWINBASEAPI= -DCOGNAC_NATIVE_NTDLL
MODULE    = ntdll.dll
IMPORTLIB = ntdll
IMPORTS   =
EXTRAINCL =

EXTRADLLFLAGS = -nodefaultlibs
i386_EXTRADLLFLAGS = -Wl,--image-base,0x7bc00000
x86_64_EXTRADLLFLAGS = -Wl,--image-base,0x180000000

VER_PRODUCTVERSION = 10,0,26100,1

# Keep the native target deliberately freestanding: no unix/*.c, ntdll.so,
# Wine server, POSIX support libraries, or Wine runtime modules.
SOURCES = \
	cognac_native.c \
	rtl_memory.c \
	cognac_syscall_x86_64.S
