# CognacOS NTDLL module configuration. Native builds use Makefile.cognac.
# Do not generate a Wine Unix companion library or compile Wine server/syscall sources.
EXTRADEFS = -D_NTSYSTEM_ -D_ACRTIMP= -DWINBASEAPI=
MODULE    = ntdll.dll
IMPORTLIB = ntdll
IMPORTS   = $(SYMCRYPT_PE_LIBS) $(ZLIB_PE_LIBS) $(MUSL_PE_LIBS)
EXTRAINCL = $(SYMCRYPT_PE_CFLAGS) $(ZLIB_PE_CFLAGS)

EXTRADLLFLAGS = -nodefaultlibs
i386_EXTRADLLFLAGS = -Wl,--image-base,0x7bc00000
x86_64_EXTRADLLFLAGS = -Wl,--image-base,0x170000000

VER_PRODUCTVERSION = 6,1,7601,24059

SOURCES = \
	actctx.c \
	alpc.c \
	atom.c \
	crypt.c \
	debugbuffer.c \
	env.c \
	error.c \
	exception.c \
	handletable.c \
	heap.c \
	large_int.c \
	loader.c \
	locale.c \
	math.c \
	misc.c \
	path.c \
	printf.c \
	process.c \
	reg.c \
	relay.c \
	resource.c \
	rtl.c \
	rtl_memory.c \
	rtlbitmap.c \
	rtlstr.c \
	sec.c \
	signal_arm.c \
	signal_arm64.c \
	signal_arm64ec.c \
	signal_i386.c \
	signal_x86_64.c \
	string.c \
	sync.c \
	thread.c \
	threadpool.c \
	time.c \
	unwind.c \
	version.c \
	wcstring.c

