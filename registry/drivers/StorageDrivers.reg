Windows Registry Editor Version 5.00

; ataport.sys is loaded during boot so the storage port layer is available
; before PnP starts. Controller and class drivers remain PnP-deferred until
; their PE images and assigned device resources are available.
; ATA port driver is loaded early so the PCI IDE function driver can bind
; controller miniports through the common port/miniport interface.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\ataport]
"Type"=dword:00000001
"Start"=dword:00000000
"ErrorControl"=dword:00000001
"Group"="SCSI Miniport"
"ImagePath"="\\SystemRoot\\System32\\drivers\\ataport.sys"

; PCI IDE framework attaches between the port and hardware-specific miniport.
; Load order is significant: ataport -> pciidex -> pciide.
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\pciidex]
"Type"=dword:00000001
"Start"=dword:00000000
"ErrorControl"=dword:00000001
"Group"="SCSI Miniport"
"Tag"=dword:00000002
"ImagePath"="\\SystemRoot\\System32\\drivers\\pciidex.sys"

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\pciide]
"Type"=dword:00000001
"Start"=dword:00000000
"ErrorControl"=dword:00000001
"Group"="SCSI Miniport"
"Tag"=dword:00000003
"ImagePath"="\\SystemRoot\\System32\\drivers\\pciide.sys"

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\storahci]
"Type"=dword:00000001
"Start"=dword:00000003
"ErrorControl"=dword:00000001
"Group"="SCSI Miniport"
"ImagePath"="\\SystemRoot\\System32\\drivers\\storahci.sys"

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\stornvme]
"Type"=dword:00000001
"Start"=dword:00000003
"ErrorControl"=dword:00000001
"Group"="SCSI Miniport"
"ImagePath"="\\SystemRoot\\System32\\drivers\\stornvme.sys"

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\disk]
"Type"=dword:00000001
"Start"=dword:00000003
"ErrorControl"=dword:00000001
"Group"="SCSI Class"
"ImagePath"="\\SystemRoot\\System32\\drivers\\disk.sys"

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\partmgr]
"Type"=dword:00000001
"Start"=dword:00000003
"ErrorControl"=dword:00000001
"Group"="System Bus Extender"
"ImagePath"="\\SystemRoot\\System32\\drivers\\partmgr.sys"
