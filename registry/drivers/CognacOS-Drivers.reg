Windows Registry Editor Version 5.00

; CognacOS native SYSTEM hive seed.
; The converter normalizes CurrentControlSet to ControlSet001 and emits a
; native REGF hive consumed by the kernel's Configuration Manager.
[HKEY_LOCAL_MACHINE\SYSTEM\Select]
"Current"=dword:00000001
"Default"=dword:00000001
"Failed"=dword:00000000
"LastKnownGood"=dword:00000001

; These two services are the first native PE driver images supported by the
; current boot-time image resolver. Bus discovery remains kernel-owned.
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Services\USBXHCI]
"Type"=dword:00000001
"Start"=dword:00000000
"ErrorControl"=dword:00000001
"Group"="Boot Bus Extender"
"Tag"=dword:00000001
"ImagePath"="\\SystemRoot\\System32\\drivers\\usbxhci.sys"

[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Services\Beep]
"Type"=dword:00000001
"Start"=dword:00000001
"ErrorControl"=dword:00000001
"Group"="Base"
"ImagePath"="\\SystemRoot\\System32\\drivers\\beep.sys"

