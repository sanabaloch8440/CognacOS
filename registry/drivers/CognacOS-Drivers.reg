Windows Registry Editor Version 5.00

; CognacOS native SYSTEM hive seed.
; The converter normalizes CurrentControlSet to ControlSet001 and emits a
; native REGF hive consumed by the kernel's Configuration Manager.
[HKEY_LOCAL_MACHINE\SYSTEM\Select]
"Current"=dword:00000001
"Default"=dword:00000001
"Failed"=dword:00000000
"LastKnownGood"=dword:00000001

; The native boot scheduler requires both Windows service-order keys. Keep the
; REG_MULTI_SZ double terminator and the GroupOrderList DWORD count/IDs exact.
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\ServiceGroupOrder]
"List"=hex(7):42,00,6f,00,6f,00,74,00,20,00,42,00,75,00,73,00,20,00,45,00,78,00,74,00,65,00,6e,00,64,00,65,00,72,00,00,00,53,00,79,00,73,00,74,00,65,00,6d,00,20,00,42,00,75,00,73,00,20,00,45,00,78,00,74,00,65,00,6e,00,64,00,65,00,72,00,00,00,53,00,43,00,53,00,49,00,20,00,6d,00,69,00,6e,00,69,00,70,00,6f,00,72,00,74,00,00,00,50,00,6f,00,72,00,74,00,00,00,50,00,72,00,69,00,6d,00,61,00,72,00,79,00,20,00,44,00,69,00,73,00,6b,00,00,00,53,00,46,00,53,00,00,00,46,00,69,00,6c,00,65,00,20,00,53,00,79,00,73,00,74,00,65,00,6d,00,00,00,42,00,6f,00,6f,00,74,00,20,00,46,00,69,00,6c,00,65,00,20,00,53,00,79,00,73,00,74,00,65,00,6d,00,00,00,42,00,61,00,73,00,65,00,00,00,00,00

[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Control\GroupOrderList]
"Boot Bus Extender"=hex:05,00,00,00,01,00,00,00,02,00,00,00,03,00,00,00,04,00,00,00,05,00,00,00

; ACPI.sys validates firmware tables and publishes the ACPI firmware interface.
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Services\ACPI]
"Type"=dword:00000001
"Start"=dword:00000000
"ErrorControl"=dword:00000001
"Group"="Boot Bus Extender"
"Tag"=dword:00000001
"ImagePath"="\\SystemRoot\\System32\\drivers\\acpi.sys"

; PCI.sys is the boot-start PCI bus extender. It owns PCI configuration-space
; enumeration; the kernel supplies only MCFG mappings and WDM PDO callbacks.
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Services\PCI]
"Type"=dword:00000001
"Start"=dword:00000000
"ErrorControl"=dword:00000001
"Group"="Boot Bus Extender"
"Tag"=dword:00000002
"ImagePath"="\\SystemRoot\\System32\\drivers\\pci.sys"

; USBXHCI, UCX and Beep are separate boot/service entries, not kernel hard-coded drivers.
[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Services\USBXHCI]
"Type"=dword:00000001
"Start"=dword:00000000
"ErrorControl"=dword:00000001
"Group"="Boot Bus Extender"
"Tag"=dword:00000003
"ImagePath"="\\SystemRoot\\System32\\drivers\\usbxhci.sys"

[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Services\UCX01020]
"Type"=dword:00000001
"Start"=dword:00000000
"ErrorControl"=dword:00000001
"Group"="Boot Bus Extender"
"Tag"=dword:00000004
"ImagePath"="\\SystemRoot\\System32\\drivers\\ucx01020.sys"

[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Services\USBHUB3]
"Type"=dword:00000001
"Start"=dword:00000000
"ErrorControl"=dword:00000001
"Group"="Boot Bus Extender"
"Tag"=dword:00000005
"ImagePath"="\\SystemRoot\\System32\\drivers\\usbhub3.sys"

[HKEY_LOCAL_MACHINE\SYSTEM\ControlSet001\Services\Beep]
"Type"=dword:00000001
"Start"=dword:00000001
"ErrorControl"=dword:00000001
"Group"="Base"
"ImagePath"="\\SystemRoot\\System32\\drivers\\beep.sys"

